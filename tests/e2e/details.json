{
  "url": "http://localhost:8080/?nointro",
  "settle": 2500,
  "ready": true,
  "steps": [
    { "name": "native cursor stays until the mouse moves", "js": "document.documentElement.classList.contains('cursor-on')", "expect": false },
    { "mouse": [600, 420], "wait": 100 },
    { "name": "cursor effects on for a mouse", "js": "document.documentElement.classList.contains('cursor-on')", "expect": true },
    { "hover": ".nav a[href='/about/']", "wait": 500 },
    { "name": "ring orbits the nav link", "js": "window.__details.state.orbit", "expect": "ABOUT" },
    { "name": "label decodes back to text", "js": "document.querySelector(\".nav a[href='/about/']\").textContent", "expect": "ABOUT", "shot": "details-orbit.png" },
    { "hover": ".cta [data-mag]", "offset": [40, -12], "wait": 350 },
    { "name": "magnet leans toward the cursor", "js": "new DOMMatrix(getComputedStyle(document.querySelector('.cta [data-mag]')).transform).m41 > 1", "expect": true },
    { "name": "ring wraps the button", "js": "window.__details.state.mag", "expect": true, "shot": "details-magnet.png" },
    { "scrollTo": "#voice", "wait": 600 },
    { "hover": "#voice .spec", "wait": 700 },
    { "name": "dimension lines on the spec block", "js": "window.__details.state.dims", "expect": 1, "shot": "details-dimensions.png" },
    { "name": "open space above: the width line stays above", "js": "window.__details.state.dimsBelow", "expect": 0 },
    { "hover": "#voice .ccard", "wait": 1100 },
    { "name": "constellation joins on hover", "js": "window.__details.state.cards", "expect": 1 },
    { "name": "constellation name fades in", "js": "Number(getComputedStyle(document.querySelector('#voice .cc-n')).opacity) > 0.9", "expect": true, "shot": "details-constellation.png" },
    { "scrollTo": "#contact", "wait": 600 },
    { "name": "contact: EMAIL ME sits clear of the CODE row", "js": "document.querySelector('#contact .spec div').getBoundingClientRect().top - document.querySelector('#contact .cta').getBoundingClientRect().bottom >= 24", "expect": true },
    { "hover": "#contact .spec", "wait": 700 },
    { "name": "contact: with room above, the width line stays above", "js": "[window.__details.state.dims, window.__details.state.dimsBelow]", "expect": [1, 0], "shot": "details-contact-dims.png" },
    { "mouse": [5, 5], "wait": 400 },
    { "js": "(window.scrollTo(0, 0), document.querySelector('.skip-link').focus(), true)", "wait": 200 },
    { "key": "Tab" },
    { "key": "Tab", "wait": 450 },
    { "name": "keyboard focus: WORK with a visible ring, decoded", "js": "[document.activeElement.textContent, getComputedStyle(document.activeElement).outlineStyle]", "expect": ["WORK", "solid"] },
    { "name": "decoding links keep a clean accessible name", "js": "[...document.querySelectorAll('.nav a:not(.home), .dec')].map(a => { a.focus(); return a.getAttribute('aria-label') || a.textContent; })", "expect": ["WORK", "ABOUT", "TIMELINE", "RESUME", "edwardware2006@gmail.com", "github.com/EdwardWare06"] }
  ]
}
