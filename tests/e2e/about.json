{
  "url": "http://localhost:8080/about/",
  "settle": 2500,
  "ready": true,
  "noExternal": true,
  "steps": [
    { "name": "title", "js": "document.querySelector('h1').textContent", "expect": "Outside the work" },
    { "name": "stage shows the attractor", "js": "window.__stage.form", "expect": 0, "shot": "about-hero.png" },
    { "name": "four sections", "js": "[...document.querySelectorAll('.sec')].map(s => s.dataset.section)", "expect": ["Where I'm from", "Training", "What's next", "Off the clock"] },
    { "name": "the Hercules card sits in the training section", "js": "!!document.querySelector('#training .ccard[data-cons=\"hercules\"]')", "expect": true },
    { "scrollTo": "#training", "wait": 500 },
    { "hover": "#training .ccard", "wait": 1100 },
    { "name": "the constellation joins on hover", "js": "window.__details.state.cards", "expect": 1, "shot": "about-training.png" },
    { "name": "copy rules", "js": "[/potterhead/i.test(document.body.textContent), document.body.textContent.includes('Harry Potter fan')]", "expect": [false, true] },
    { "name": "next link", "js": "document.querySelector('a.next').getAttribute('href')", "expect": "/timeline/" },
    { "name": "no horizontal scroll", "js": "document.documentElement.scrollWidth <= innerWidth", "expect": true }
  ]
}
