{
  "url": "http://localhost:8080/?nogl&nointro",
  "settle": 2500,
  "steps": [
    { "name": "no canvas stage", "js": "document.querySelector('.stage').classList.contains('no-gl')", "expect": true },
    { "name": "hero shows the galaxy still", "js": "[...document.querySelectorAll('.stage img')].some(i => i.src.endsWith('/form-4.webp') && i.style.opacity === '1')", "expect": true },
    { "scrollTo": "#hunt", "wait": 1800 },
    { "name": "Hunt crossfades to the black hole still", "js": "[...document.querySelectorAll('.stage img')].some(i => i.src.endsWith('/form-2.webp') && i.style.opacity === '1')", "expect": true, "shot": "fallback-hunt.png" },
    { "name": "replay intro hidden without the stage", "js": "document.querySelector('.replay-intro').hidden", "expect": true },
    { "name": "details still work", "js": "document.documentElement.classList.contains('cursor-on')", "expect": true }
  ]
}
